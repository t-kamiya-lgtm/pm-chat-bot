# Cloud SQL (PostgreSQL) — src/lib/db.ts が @google-cloud/cloud-sql-connector 経由で接続
# インスタンス接続名は `gcloud sql instances describe <instance> --format="value(connectionName)"` で確認
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
DB_USER=
DB_NAME=
# CLOUD_SQL_AUTH_TYPE=IAM の場合は不要(IAMデータベース認証を使う場合のみ)
DB_PASSWORD=
# PUBLIC(既定) | PRIVATE。VPCコネクタ未設定の環境ではPUBLICのまま(接続自体はmTLSで暗号化される)
CLOUD_SQL_IP_TYPE=
# PASSWORD(既定) | IAM
CLOUD_SQL_AUTH_TYPE=

# Firebase Authentication (Google Cloud Identity Platform)
# クライアント側設定(Firebaseコンソール > プロジェクトの設定 >全般 で確認できる、秘匿情報ではない)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# サーバー側(firebase-admin)。Cloud Run上ではADCでプロジェクトを自動検出できるが、
# 未設定時にエラーメッセージが分かりにくいため明示指定を推奨
FIREBASE_PROJECT_ID=

# 管理画面ログインを許可するGoogle Workspaceドメイン(例: primedirect.jp)
ADMIN_ALLOWED_GOOGLE_DOMAIN=
NEXT_PUBLIC_ADMIN_ALLOWED_GOOGLE_DOMAIN=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# 商品QA自動生成(未設定時はテンプレート生成にフォールバック)
ANTHROPIC_API_KEY=

# 問い合わせフォーム通知メール
INQUIRY_NOTIFICATION_EMAIL=
INQUIRY_FROM_EMAIL=
# 運用テスト期間中はtrueにすると、件名に【テスト】が付く
INQUIRY_TEST_MODE=

# 代引き・後払い注文のスマレジEC連携失敗アラート送信先(未設定時はINQUIRY_NOTIFICATION_EMAILにフォールバック)
SMAREGI_SYNC_ALERT_EMAIL=

# 注文完了メール・離脱者リマインドメールの送信元(未設定時は chatbot@example.com)
ORDER_EMAIL_FROM=

# 上記すべてのメール送信先(GAS Webhook経由。未設定時はコンソールログにフォールバック)
GAS_MAIL_WEBHOOK_URL=
GAS_MAIL_SECRET=
# メール内の配信停止リンクなどに使う、本番サイトの絶対URL(例: https://example.com)
NEXT_PUBLIC_SITE_URL=
# 離脱者リマインドメール送信バッチ(/api/cron/abandoned-leads)を外部Cronサービスから
# 呼び出す際の認証シークレット。ヘッダー "Authorization: Bearer <secret>" またはクエリ "?secret=" で照合する
CRON_SECRET=
